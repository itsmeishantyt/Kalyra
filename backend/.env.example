# ─── Server ───────────────────────────────────────────────
PORT=3000
NODE_ENV=development

# ─── Database ─────────────────────────────────────────────
DB_PATH=./db/kalyra.db

# ─── JWT ──────────────────────────────────────────────────
# Generate strong secrets: node -e "console.log(require('crypto').randomBytes(64).toString('hex'))"
JWT_ACCESS_SECRET=kalyra_access_secret_change_in_production
JWT_REFRESH_SECRET=kalyra_refresh_secret_change_in_production
JWT_ACCESS_EXPIRES=15m
JWT_REFRESH_EXPIRES=7d

# ─── CORS ─────────────────────────────────────────────────
FRONTEND_ORIGIN=http://localhost:5500

# ─── File Uploads ─────────────────────────────────────────
UPLOAD_PATH=./uploads
MAX_FILE_SIZE_MB=5

# ─── Razorpay (Mock until real keys provided) ─────────────
RAZORPAY_KEY_ID=mock_key_id
RAZORPAY_KEY_SECRET=mock_key_secret
RAZORPAY_MOCK_MODE=true

# ─── Password Reset (Local Dev Mode) ──────────────────────
# In production, set SMTP vars and RESET_MODE=email
RESET_MODE=local
RESET_TOKEN_EXPIRES_MINUTES=30
